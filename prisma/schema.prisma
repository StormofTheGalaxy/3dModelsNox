// PolyForge — схема данных.
//
// Фаза 0 покрывает аккаунты, инвайт-гейт, сессии, реестр настроек и аудит-лог.
// Сущности профилей, ТЗ, заказов и сделок приходят в фазах 1–5; поля, которые
// им понадобятся (organizationId, deletedAt), заложены здесь заранее — §1.2.2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Перечисления
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  user
  moderator
  arbiter
  admin
}

enum UserStatus {
  active
  shadow_banned
  temp_banned
  banned
  deleted
}

enum Locale {
  ru
  en
}

enum ThemePreference {
  dark
  light
  system
}

/// Какой профиль пользователь открыл последним — переключатель в шапке.
enum RoleContext {
  designer
  customer
}

enum AuthTokenType {
  email_verification
  password_reset
  email_change
}

enum OAuthProvider {
  discord
}

// ─────────────────────────────────────────────────────────────────────────────
// Аккаунты
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?

  /// Аккаунт-хэндл. Профили дизайнера и заказчика (фаза 1) могут показывать
  /// собственные отображаемые имена, но адресуемся к пользователю по нику.
  nickname       String  @unique
  nicknameLower  String  @unique

  locale Locale          @default(ru)
  theme  ThemePreference @default(dark)

  role   UserRole   @default(user)
  status UserStatus @default(active)

  emailVerifiedAt DateTime?
  banUntil        DateTime?
  banReason       String?

  /// Последний выбранный контекст интерфейса (дизайнер/заказчик).
  lastRoleContext RoleContext @default(designer)

  invitedById String?
  invitedBy   User?   @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[] @relation("UserInvitedBy")

  invitesLeft Int @default(0)

  /// Задел на команды/студии — фаза 2 (§1.4).
  organizationId String?

  lastSeenAt DateTime?
  lastIp     String?

  /// Обезличивание при самоудалении (§2.4): запись остаётся, данные стираются.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitesOwned    Invite[]        @relation("InviteOwner")
  inviteUsed      Invite?         @relation("InviteUsedBy")
  authTokens      AuthToken[]
  sessions        RefreshSession[]
  oauthAccounts   OAuthAccount[]
  auditLogs       AuditLog[]      @relation("AuditActor")
  settingsChanged PlatformSetting[] @relation("SettingUpdatedBy")

  designerProfile DesignerProfile?
  customerProfile CustomerProfile?
  works           PortfolioWork[]  @relation("WorkAuthor")
  workLikes       WorkLike[]       @relation("WorkLiker")
  reportsFiled    Report[]         @relation("ReportAuthor")
  reportsResolved Report[]         @relation("ReportResolver")

  briefs          Brief[]          @relation("BriefOwner")
  briefVersions   BriefVersion[]   @relation("BriefVersionAuthor")
  briefTemplates  BriefTemplate[]  @relation("BriefTemplateOwner")
  briefChanges    BriefChangeRequest[] @relation("BriefChangeAuthor")
  aiCredits       AICreditLedger[] @relation("AICreditOwner")

  orders          Order[]          @relation("OrderCustomer")
  responses       OrderResponse[]  @relation("ResponseDesigner")
  savedFilters    SavedFilter[]    @relation("SavedFilterOwner")
  notifications   Notification[]   @relation("NotificationRecipient")
  notificationPrefs NotificationPreference[] @relation("NotificationPrefOwner")

  dealsAsCustomer Deal[]                @relation("DealCustomer")
  dealsAsDesigner Deal[]                @relation("DealDesigner")
  paymentsUploaded PaymentConfirmation[] @relation("PaymentUploader")
  dealMessages    DealMessage[]         @relation("MessageAuthor")
  disputesOpened  Dispute[]             @relation("DisputeAuthor")
  disputesArbitrated Dispute[]          @relation("DisputeArbiter")

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model OAuthAccount {
  id String @id @default(cuid())

  provider          OAuthProvider
  providerAccountId String
  /// Кэш профиля провайдера для отображения и повторной привязки.
  username          String?
  avatarUrl         String?
  email             String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

/// Одноразовые токены: подтверждение email, сброс пароля, смена email.
/// В базе лежит только HMAC-хэш — исходный токен уходит пользователю в письме.
model AuthToken {
  id        String        @id @default(cuid())
  type      AuthTokenType
  tokenHash String        @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Для email_change — новый адрес, ожидающий подтверждения.
  payload Json?

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Refresh-сессия. Access-токен живёт 15 минут и в базе не хранится.
model RefreshSession {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  ip        String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Закрытая бета: инвайты и лист ожидания
// ─────────────────────────────────────────────────────────────────────────────

model Invite {
  id   String @id @default(cuid())
  code String @unique

  ownerId String?
  owner   User?   @relation("InviteOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  /// Один инвайт — один вошедший пользователь.
  usedById String?   @unique
  usedBy   User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt   DateTime?

  /// Инвайты, выданные админом напрямую в лист ожидания.
  sentToEmail String?
  note        String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
  @@index([usedAt])
  @@map("invites")
}

model WaitlistEntry {
  id     String  @id @default(cuid())
  email  String  @unique
  note   String?
  locale Locale  @default(ru)
  source String?

  invitedAt DateTime?
  inviteId  String?

  createdAt DateTime @default(now())

  @@index([invitedAt])
  @@map("waitlist_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Настройки платформы и аудит
// ─────────────────────────────────────────────────────────────────────────────

/// Реестр ключей типизирован в `@polyforge/shared/settings`. Здесь — только
/// хранилище: всё, что помечено в ТЗ как «настройка», живёт тут (§1.2.6).
model PlatformSetting {
  key   String @id
  value Json

  updatedById String?
  updatedBy   User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// Append-only. Записи не редактируются и не удаляются (§2.4).
model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  targetType String?
  targetId   String?

  payload Json?
  ip      String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Фаза 1: профили и портфолио
// ─────────────────────────────────────────────────────────────────────────────

enum Specialization {
  character
  environment
  props
  weapons
  vehicles
  animation
  rigging
  texturing
  other
}

enum ArtStyle {
  realism
  stylized
  lowpoly
  pixel
  anime
  scifi
  fantasy
  other
}

enum AssetType {
  character
  environment
  prop
  weapon
  vehicle
  building
  animation
  texture
  other
}

enum Availability {
  open
  busy
  closed
}

enum DesignerLevel {
  novice
  verified
  pro
  top
}

enum CustomerType {
  indie
  studio
  server_project
  other
}

enum MediaType {
  image
  video
}

/// Медиа появляется сразу после загрузки, а сжатие и webp делает воркер.
enum MediaStatus {
  processing
  ready
  failed
}

enum WorkVisibility {
  public
  link_only
}

enum WorkSource {
  uploaded
  from_deal
}

enum ReportTargetType {
  user
  work
  order
  brief
  message
  review
}

enum ReportCategory {
  spam
  abuse
  fraud
  nsfw
  plagiarism
  rules_evasion
}

enum ReportStatus {
  open
  confirmed
  rejected
}

/// Профиль дизайнера. Создаётся при первом использовании роли (§1.4).
model DesignerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  avatarUrl String?
  coverUrl  String?

  country   String?
  languages String[] @default([])

  specializations Specialization[] @default([])
  styles          ArtStyle[]       @default([])
  /// Свободный список: пресеты лежат в @polyforge/shared, но «другое» разрешено.
  software        String[]         @default([])
  engines         String[]         @default([])

  /// Деньги в целых единицах валюты: копейки в ставке фрилансера не нужны.
  hourlyRate Int?
  minBudget  Int?
  currency   String @default("USD")

  availability Availability @default(open)
  bio          String?

  level      DesignerLevel @default(novice)
  verifiedAt DateTime?

  // Кэшируемые метрики (§3). Пересчёт — в фазах 4–5.
  ordersCompleted   Int   @default(0)
  rating            Float @default(0)
  ratingCount       Int   @default(0)
  onTimePct         Int?
  repeatClientsPct  Int?
  disputesLost      Int   @default(0)
  responsesToday    Int   @default(0)

  /// Заполнен ли профиль настолько, чтобы показывать его в каталоге.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([availability, level])
  @@index([completedAt])
  @@map("designer_profiles")
}

/// Профиль заказчика. Тот же аккаунт, другой контекст.
model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName  String
  avatarUrl    String?
  type         CustomerType @default(indie)
  projectLinks String[]     @default([])
  bio          String?

  ordersCreated       Int   @default(0)
  dealsCompleted      Int   @default(0)
  rating              Float @default(0)
  ratingCount         Int   @default(0)
  responsivenessScore Int?
  disputesLost        Int   @default(0)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

model PortfolioWork {
  id String @id @default(cuid())

  designerId String
  designer   User   @relation("WorkAuthor", fields: [designerId], references: [id], onDelete: Cascade)

  title       String
  description String?

  assetType AssetType?
  styles    ArtStyle[] @default([])
  software  String[]   @default([])
  engines   String[]   @default([])

  // Техблок — весь опциональный (§4.3).
  polycount      Int?
  textureInfo    String?
  formats        String[] @default([])
  timeSpentHours Int?

  source          WorkSource @default(uploaded)
  dealId          String?
  /// Бейдж «Выполнено на платформе» — только для работ из завершённых сделок.
  badgeOnPlatform Boolean    @default(false)

  visibility WorkVisibility @default(public)
  /// Для visibility=link_only: работа открывается только по этому токену.
  shareToken String?        @unique

  views      Int @default(0)
  likesCount Int @default(0)

  /// Пост-модерация: работы не проходят премодерацию (§4.3).
  isHidden   Boolean   @default(false)
  hiddenAt   DateTime?
  hiddenById String?

  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media WorkMedia[]
  likes WorkLike[]

  @@index([designerId, publishedAt])
  @@index([visibility, isHidden, publishedAt])
  @@index([visibility, isHidden, likesCount])
  @@map("portfolio_works")
}

model WorkMedia {
  id     String        @id @default(cuid())
  workId String
  work   PortfolioWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  type   MediaType
  status MediaStatus @default(processing)

  /// Ключ оригинала в хранилище — по нему воркер забирает файл на обработку.
  storageKey   String
  url          String
  thumbnailUrl String?

  width           Int?
  height          Int?
  sizeBytes       Int?
  durationSeconds Int?

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workId, order])
  @@map("work_media")
}

model WorkLike {
  id String @id @default(cuid())

  workId String
  work   PortfolioWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("WorkLiker", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workId, userId])
  @@index([userId])
  @@map("work_likes")
}

/// Жалоба на любой объект платформы (§4.10). Разбор — в админке фазы 7.
model Report {
  id String @id @default(cuid())

  reporterId String?
  reporter   User?   @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: SetNull)

  targetType ReportTargetType
  targetId   String
  category   ReportCategory
  text       String?

  status         ReportStatus @default(open)
  resolvedById   String?
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())

  /// Один пользователь — одна открытая жалоба на объект.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Фаза 2: система ТЗ
// ─────────────────────────────────────────────────────────────────────────────

enum BriefStatus {
  draft
  active
  /// Заморожено стартом сделки: правки только через BriefChangeRequest (§4.4).
  frozen
  archived
}

enum BriefAccess {
  private
  link
  selected
  public
}

/// Кто автор ТЗ. Дизайнер тоже может собрать ТЗ — например, под свой оффер.
enum BriefOwnerRole {
  customer
  designer
}

enum BriefChangeStatus {
  pending
  accepted
  rejected
}

enum PdfExportStatus {
  pending
  ready
  failed
}

model Brief {
  id String @id @default(cuid())

  ownerId   String
  owner     User           @relation("BriefOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerRole BriefOwnerRole @default(customer)

  title  String
  status BriefStatus @default(draft)
  access BriefAccess @default(private)

  /// Секретная ссылка для access=link. Создаётся при первом шаринге.
  shareToken String? @unique

  /// Точечный доступ для access=selected.
  allowedUserIds String[] @default([])

  /// Язык, на котором ТЗ написано. Перевод для зрителя — фаза 6.
  sourceLocale Locale @default(ru)

  /// Пять секций по zod-схеме из @polyforge/shared. JSON, потому что состав
  /// полей меняется вместе с продуктом, а миграция на каждое поле не нужна.
  sections Json

  /// Номер последней версии. Снимок каждой лежит в BriefVersion.
  currentVersion Int @default(1)

  /// Экспорт в PDF готовит воркер; здесь — ссылка на последний результат.
  pdfStatus     PdfExportStatus?
  pdfUrl        String?
  pdfStorageKey String?
  pdfVersion    Int?

  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions       BriefVersion[]
  changeRequests BriefChangeRequest[]
  orders         Order[]              @relation("OrderBrief")

  @@index([ownerId, updatedAt])
  @@index([status, access])
  @@map("briefs")
}

/// Снимок ТЗ. Сделка замораживает конкретную версию (§4.4), поэтому снимки
/// неизменяемы: правка ТЗ создаёт новую запись, а не переписывает старую.
model BriefVersion {
  id String @id @default(cuid())

  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  version  Int
  title    String
  sections Json

  authorId String?
  author   User?   @relation("BriefVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  comment String?

  createdAt DateTime @default(now())

  deals Deal[] @relation("DealBriefVersion")

  @@unique([briefId, version])
  @@index([briefId, createdAt])
  @@map("brief_versions")
}

/// Пресеты ТЗ: системные из seed и личные («Сохранить как мой шаблон»).
/// Публичные шаблоны сообщества — фаза 2 post-MVP.
model BriefTemplate {
  id String @id @default(cuid())

  /// Стабильный ключ системного пресета; у личных шаблонов пуст.
  key String? @unique

  ownerId String?
  owner   User?   @relation("BriefTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  isSystem Boolean @default(false)
  /// Порядок в списке пресетов.
  order    Int     @default(0)

  /// Подписи системных пресетов — ключи i18n; у личных это готовый текст.
  title       String
  description String?

  sections Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([isSystem, order])
  @@map("brief_templates")
}

/// Запрос на изменение замороженного ТЗ. Модель заводится сейчас,
/// UI появится вместе со сделками в фазе 4 (§7).
model BriefChangeRequest {
  id String @id @default(cuid())

  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// Сделка, в рамках которой запрошено изменение.
  dealId String?

  authorId String?
  author   User?   @relation("BriefChangeAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  description String
  /// Предлагаемые секции целиком — сравнение показывает UI.
  proposed    Json?

  status       BriefChangeStatus @default(pending)
  resolvedById String?
  resolvedAt   DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())

  @@index([briefId, status])
  @@map("brief_change_requests")
}

/// Расход ИИ-кредитов (§3). Append-only: баланс считается по журналу,
/// поэтому историю списаний всегда можно показать пользователю.
model AICreditLedger {
  id String @id @default(cuid())

  userId String
  user   User   @relation("AICreditOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// Ключ ИИ-фичи из реестра настроек `ai_feature_costs`.
  feature String
  /// Списание положительное, возврат при ошибке — отрицательный.
  cost    Int

  /// Пул, из которого списано: brief_generate или общий.
  pool String @default("general_pool")

  /// Период учёта в формате YYYY-MM: месячный лимит считается по нему.
  period String

  targetType String?
  targetId   String?

  createdAt DateTime @default(now())

  @@index([userId, period, pool])
  @@index([createdAt])
  @@map("ai_credit_ledger")
}

// ─────────────────────────────────────────────────────────────────────────────
// Фаза 3: витрина заказов, отклики, уведомления
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  draft
  published
  in_progress
  completed
  cancelled
  archived
}

/// Аукцион — post-MVP (§3): схема заложена, UI не делается.
enum OrderWorkMode {
  fixed
  auction
}

enum ResponseStatus {
  new
  viewed
  shortlist
  rejected
  accepted
}

/// Шаблонные причины отказа: свободный текст здесь чаще ранит, чем помогает.
enum ResponseRejectReason {
  price_too_high
  timeline_too_long
  portfolio_mismatch
  chose_another
  order_cancelled
  other
}

enum NotificationType {
  order_new_match
  order_response_received
  order_customer_inactive
  order_expiring
  response_status_changed
  response_accepted
  brief_shared
  deal_started
  deal_plan_changed
  deal_milestone_submitted
  deal_revision_requested
  deal_milestone_accepted
  deal_payment_claimed
  deal_payment_confirmed
  deal_payment_stuck
  deal_deadline_soon
  deal_message
  deal_completed
  deal_brief_change
  dispute_opened
  dispute_resolved
  system
}

model Order {
  id String @id @default(cuid())

  customerId String
  customer   User   @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  /// ТЗ, из которого опубликован заказ. Одно ТЗ может использоваться в
  /// нескольких заказах — сделка хранит снимок версии (§4.4).
  briefId String
  brief   Brief  @relation("OrderBrief", fields: [briefId], references: [id], onDelete: Restrict)

  title    String
  workMode OrderWorkMode @default(fixed)
  status   OrderStatus   @default(draft)

  /// Денормализовано из ТЗ на момент публикации: витрина не должна ходить
  /// в JSON секций на каждой карточке.
  assetType  AssetType?
  styles     ArtStyle[] @default([])
  engine     String?
  platform   String?

  budgetMode     String  @default("open")
  budgetAmount   Int?
  budgetCurrency String  @default("USD")
  deadline       DateTime?

  /// Превью-референс из ТЗ для карточки.
  previewUrl String?

  /// Материал для полнотекстового поиска: заголовок, описание и теги.
  searchText String @default("")

  /// Точное число видит только заказчик; публично — градация конкуренции.
  responsesCount Int @default(0)

  invitedDesignerIds String[] @default([])

  publishedAt DateTime?
  /// Автоархив через N дней без активности (§4.5). Продление в один клик.
  expiresAt   DateTime?
  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses OrderResponse[]
  bids      Bid[]
  deal      Deal?           @relation("DealOrder")

  @@index([status, publishedAt])
  @@index([customerId, status])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderResponse {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  designerId String
  designer   User   @relation("ResponseDesigner", fields: [designerId], references: [id], onDelete: Cascade)

  coverText String
  price     Int
  currency  String @default("USD")
  days      Int

  /// 1–3 работы из портфолио (§3).
  attachedWorkIds String[] @default([])

  /// Приглашённые помечаются и поднимаются в списке.
  isInvited Boolean @default(false)

  status       ResponseStatus        @default(new)
  rejectReason ResponseRejectReason?

  /// Когда заказчик открыл отклик — от этого считается его отзывчивость.
  viewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один дизайнер — один отклик на заказ.
  @@unique([orderId, designerId])
  @@index([designerId, createdAt])
  @@index([orderId, status])
  @@map("order_responses")
}

/// Сохранённый поиск по витрине (§4.5) с уведомлениями о новых совпадениях.
model SavedFilter {
  id String @id @default(cuid())

  userId String
  user   User   @relation("SavedFilterOwner", fields: [userId], references: [id], onDelete: Cascade)

  title  String
  /// Параметры фильтра по zod-схеме `orderFilterSchema`.
  params Json

  notifyEmail  Boolean @default(true)
  notifyInApp  Boolean @default(true)

  /// До какого момента совпадения уже разосланы — курсор дайджеста.
  lastNotifiedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_filters")
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  /// Данные для отрисовки: заголовки, идентификаторы, ссылки.
  payload Json

  readAt DateTime?
  /// Отправлено ли письмо — чтобы дайджест не продублировал уведомление.
  emailSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Настройки подписок по типам уведомлений (§4.7).
model NotificationPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation("NotificationPrefOwner", fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  inApp Boolean @default(true)
  email Boolean @default(true)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ── Аукцион: post-MVP (§3). Схема заложена, логика и UI не делаются. ────────

enum AuctionMode {
  open_reverse
  sealed
}

model Auction {
  id String @id @default(cuid())

  orderId String @unique
  mode    AuctionMode @default(open_reverse)

  startPrice Int?
  currency   String @default("USD")
  endsAt     DateTime?

  /// Торги необязывающие; отказ победителя фиксируется и бьёт по метрике.
  winnerBidId String?
  closedAt    DateTime?

  createdAt DateTime @default(now())

  @@map("auctions")
}

model Bid {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  designerId String
  amount     Int
  currency   String @default("USD")
  days       Int?

  withdrawnAt DateTime?
  createdAt   DateTime @default(now())

  @@index([orderId, amount])
  @@map("bids")
}

// ─────────────────────────────────────────────────────────────────────────────
// Фаза 4: сделки, этапы, чеки, сдачи, чат, споры
// ─────────────────────────────────────────────────────────────────────────────

enum DealStatus {
  /// План этапов согласуется: сделка ещё не в работе (§4.6).
  plan_agreement
  active
  paused
  in_dispute
  completed
  cancelled
}

enum MilestoneStatus {
  pending
  in_work
  submitted
  revision
  accepted
  /// Заказчик заявил об оплате и приложил чек.
  paid_claimed
  /// Дизайнер подтвердил получение денег — этап закрыт.
  paid_confirmed
}

enum PaymentMethod {
  card
  crypto
  paypal
  sbp
  other
}

enum PaymentStatus {
  pending
  confirmed
  /// Дизайнер молчит: чек висит, админ видит флаг (§4.6).
  stuck
}

/// Выборочная проверка чеков админом (§4.10).
enum PaymentAdminCheck {
  none
  random_ok
  flagged
  verified
}

enum DealMessageKind {
  user
  /// Системные события ленты: «этап сдан», «чек загружен», «спор открыт».
  system
}

enum DisputeStatus {
  open
  resolved
}

enum DisputeVerdict {
  designer_right
  customer_right
  mutual
}

/// Сделка. Хранит снимок версии ТЗ: изменения после старта идут через
/// BriefChangeRequest с подтверждением второй стороны (§4.4, §4.6).
model Deal {
  id String @id @default(cuid())

  orderId String? @unique
  order   Order?  @relation("DealOrder", fields: [orderId], references: [id], onDelete: SetNull)

  briefVersionId String
  briefVersion   BriefVersion @relation("DealBriefVersion", fields: [briefVersionId], references: [id], onDelete: Restrict)

  customerId String
  customer   User   @relation("DealCustomer", fields: [customerId], references: [id], onDelete: Restrict)

  designerId String
  designer   User   @relation("DealDesigner", fields: [designerId], references: [id], onDelete: Restrict)

  title    String
  price    Int
  currency String @default("USD")

  /// Раунды правок из принятого отклика: расходуются по этапам.
  revisionRoundsIncluded Int @default(2)

  status DealStatus @default(plan_agreement)

  /// План подтверждают обе стороны — только после этого сделка активна.
  planConfirmedByCustomerAt DateTime?
  planConfirmedByDesignerAt DateTime?

  pausedAt    DateTime?
  pauseReason String?

  completedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?

  /// Согласие заказчика на публикацию работы в портфолио (§4.6).
  portfolioAllowed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
  messages   DealMessage[]
  dispute    Dispute?

  @@index([customerId, status])
  @@index([designerId, status])
  @@map("deals")
}

model Milestone {
  id String @id @default(cuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Порядковый номер в плане: 1..10 (§3).
  position    Int
  title       String
  description String?

  amount   Int
  currency String @default("USD")
  dueDate  DateTime?

  status MilestoneStatus @default(pending)

  /// Сколько раундов правок уже израсходовано на этом этапе.
  revisionRoundsUsed Int @default(0)

  submittedAt DateTime?
  acceptedAt  DateTime?
  /// Сдан ли этап в срок — из этого считается onTimePct дизайнера (§4.6).
  wasLate     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]
  payments   PaymentConfirmation[]

  @@unique([dealId, position])
  @@index([dealId, status])
  @@index([status, dueDate])
  @@map("milestones")
}

/// Сдача этапа. Версии накапливаются: v1, v2… — история правок видна обеим
/// сторонам и нужна при разборе спора.
model Delivery {
  id String @id @default(cuid())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  version Int
  note    String?

  createdAt DateTime @default(now())

  files DeliveryFile[]

  @@unique([milestoneId, version])
  @@map("deliveries")
}

model DeliveryFile {
  id String @id @default(cuid())

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  /// Исходники лежат в приватном бакете и открываются заказчику только
  /// после подтверждения оплаты финального этапа (§4.6).
  isSource Boolean @default(true)

  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int

  /// Публичное превью: для финала воркер накладывает водяной знак.
  previewUrl        String?
  watermarkedUrl    String?
  watermarkPending  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([deliveryId])
  @@map("delivery_files")
}

/// Подтверждение оплаты (§3). Платформа денег не проводит — только фиксирует
/// то, что стороны предоставили сами.
model PaymentConfirmation {
  id String @id @default(cuid())

  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("PaymentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  amount   Int
  currency String        @default("USD")
  method   PaymentMethod @default(other)
  txHash   String?
  note     String?

  customerClaimedAt   DateTime  @default(now())
  designerConfirmedAt DateTime?

  status     PaymentStatus     @default(pending)
  adminCheck PaymentAdminCheck @default(none)

  /// Когда уходили напоминания дизайнеру — чтобы не слать их повторно.
  remindedAt DateTime?
  reminderCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files PaymentFile[]

  @@index([milestoneId])
  @@index([status, customerClaimedAt])
  @@map("payment_confirmations")
}

model PaymentFile {
  id String @id @default(cuid())

  paymentId String
  payment   PaymentConfirmation @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Чеки всегда в приватном бакете: доступ только участникам и админу.
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("payment_files")
}

/// Сообщение чата сделки (§4.7). Пре-сделочный тред привязан к отклику
/// и продолжается в сделке.
model DealMessage {
  id String @id @default(cuid())

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// Пре-сделочный чат: тред по отклику до старта сделки.
  responseId String?

  kind DealMessageKind @default(user)

  authorId String?
  author   User?   @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  text String

  /// Для системных сообщений — ключ словаря и подстановки.
  systemKey     String?
  systemPayload Json?

  quotedMessageId String?
  pinned          Boolean @default(false)

  /// Кэш ИИ-перевода: {lang, text}. Наполняется в фазе 6.
  translatedText Json?

  readByCustomerAt DateTime?
  readByDesignerAt DateTime?

  createdAt DateTime @default(now())

  attachments MessageAttachment[]

  @@index([dealId, createdAt])
  @@index([responseId, createdAt])
  @@map("deal_messages")
}

model MessageAttachment {
  id String @id @default(cuid())

  messageId String
  message   DealMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  /// Для картинок — публичное превью, чтобы не подписывать ссылку на каждый рендер.
  previewUrl String?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

/// Спор (§4.6). Сделка при открытии замораживается; последствия
/// репутационные — деньги платформа не возвращает.
model Dispute {
  id String @id @default(cuid())

  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  openedById String
  openedBy   User   @relation("DisputeAuthor", fields: [openedById], references: [id], onDelete: Restrict)

  reason String

  status  DisputeStatus   @default(open)
  verdict DisputeVerdict?

  arbiterId String?
  arbiter   User?   @relation("DisputeArbiter", fields: [arbiterId], references: [id], onDelete: SetNull)

  /// Саммари переписки, которое арбитр запрашивает кнопкой.
  aiSummary      String?
  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("disputes")
}
