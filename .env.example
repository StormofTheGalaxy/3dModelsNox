# ─────────────────────────────────────────────────────────────
# PolyForge — шаблон переменных окружения
# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env.
# ─────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────
NODE_ENV=development
BRAND_NAME=PolyForge
# Базовый публичный URL приложения (без слэша на конце)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ── База данных ──────────────────────────────────────────────
POSTGRES_USER=polyforge
POSTGRES_PASSWORD=polyforge
POSTGRES_DB=polyforge
DATABASE_URL=postgresql://polyforge:polyforge@localhost:5432/polyforge?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Секреты аутентификации ───────────────────────────────────
# Сгенерировать: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-access-token-secret-min-32-chars
AUTH_REFRESH_SECRET=change-me-refresh-token-secret-min-32-chars
# Секрет для одноразовых токенов (подтверждение email, сброс пароля)
AUTH_TOKEN_PEPPER=change-me-token-pepper

# ── Discord OAuth ────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Cloudflare Turnstile (капча) ─────────────────────────────
# Тестовые ключи Cloudflare: всегда проходят проверку
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="PolyForge <noreply@example.com>"
# В dev без ключа письма пишутся в консоль воркера/приложения
EMAIL_TRANSPORT=console

# ── Хранилище файлов ─────────────────────────────────────────
# local — файлы на диске (разработка), s3 — прод
STORAGE_DRIVER=local
# Относительный путь разрешается от корня монорепо
STORAGE_LOCAL_DIR=.data/uploads

# ── S3-совместимое хранилище (Timeweb S3) ────────────────────
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=polyforge-public
S3_BUCKET_PRIVATE=polyforge-private
S3_PUBLIC_BASE_URL=https://cdn.example.com

# ── ИИ (OpenAI) ──────────────────────────────────────────────
# Без ключа поднимается детерминированная заглушка для разработки:
# ИИ-фичи и списание кредитов работают, но результат собирается правилами.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Telegram-бот ─────────────────────────────────────────────
# Третий канал уведомлений (§4.7). Без токена поднимается заглушка:
# привязка чата и выбор канала работают, наружу ничего не уходит.
# TELEGRAM_BOT_USERNAME — имя бота без «@», нужно для диплинка привязки.
# TELEGRAM_WEBHOOK_SECRET — произвольная строка, её же Telegram присылает
# заголовком X-Telegram-Bot-Api-Secret-Token; сгенерировать так же, как
# остальные секреты: openssl rand -base64 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── Веб-пуши ─────────────────────────────────────────────────
# Четвёртый канал уведомлений (§4.7). Без пары ключей поднимается
# заглушка: подписка в браузере оформляется, наружу ничего не уходит.
# Пара генерируется один раз: npm run push:keys
# Менять её нельзя без цены — публичный ключ вшит в каждую оформленную
# подписку, после смены все они разом перестают работать.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# ── Аналитика ────────────────────────────────────────────────
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA4_ID=

# ── Сидирование суперадмина ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NICKNAME=admin

# ── Прод: домен для Caddy ────────────────────────────────────
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Аналитика (фаза 7). Пусто — счётчики не подключаются.
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
